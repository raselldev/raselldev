@model ErrorLogDashboard.Web.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Summary Cards Section -->
<div class="row mb-4" id="summaryCards">
    <div class="col-md-6 col-lg mb-3">
        <div class="card summary-card h-100 border-primary">
            <div class="card-body text-center">
                <div class="card-icon text-primary">
                    <i class="bi bi-bug-fill"></i>
                </div>
                <h2 class="card-title mb-0" id="totalErrors">@Model.Summary.TotalErrors</h2>
                <p class="card-text text-muted">Total Errors</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg mb-3">
        <div class="card summary-card h-100 border-danger">
            <div class="card-body text-center">
                <div class="card-icon text-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h2 class="card-title mb-0 text-danger" id="unresolvedErrors">@Model.Summary.UnresolvedErrors</h2>
                <p class="card-text text-muted">Unresolved</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg mb-3">
        <div class="card summary-card h-100 border-success">
            <div class="card-body text-center">
                <div class="card-icon text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h2 class="card-title mb-0 text-success" id="resolvedErrors">@Model.Summary.ResolvedErrors</h2>
                <p class="card-text text-muted">Resolved</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg mb-3">
        <div class="card summary-card h-100 border-warning">
            <div class="card-body text-center">
                <div class="card-icon text-warning">
                    <i class="bi bi-code-slash"></i>
                </div>
                <h2 class="card-title mb-0" id="uniqueSources">@Model.Summary.UniqueErrorSources</h2>
                <p class="card-text text-muted">Unique Sources</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg mb-3">
        <div class="card summary-card h-100 border-info">
            <div class="card-body text-center">
                <div class="card-icon text-info">
                    <i class="bi bi-phone-fill"></i>
                </div>
                <h2 class="card-title mb-0" id="affectedPlatforms">@Model.Summary.AffectedPlatforms</h2>
                <p class="card-text text-muted">Platforms</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row mb-4">
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart-fill me-2"></i>Errors by Platform
            </div>
            <div class="card-body">
                <canvas id="platformChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart-fill me-2"></i>Resolution Status
            </div>
            <div class="card-body">
                <canvas id="resolutionChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-bar-chart-fill me-2"></i>Errors by Version
            </div>
            <div class="card-body">
                <canvas id="versionChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-bar-chart-fill me-2"></i>Top 10 Sources
            </div>
            <div class="card-body">
                <canvas id="sourceChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Error Trends Chart -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-graph-up me-2"></i>Error Trends (Last 30 Days)
            </div>
            <div class="card-body">
                <canvas id="trendChart" style="height: 250px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Filters Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-funnel-fill me-2"></i>Filters</span>
                <button class="btn btn-sm btn-outline-secondary" id="resetFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6 col-lg-2">
                        <label for="filterPlatform" class="form-label">Platform</label>
                        <select class="form-select" id="filterPlatform">
                            <option value="">All Platforms</option>
                            @foreach (var platform in Model.Platforms)
                            {
                                <option value="@platform">@platform</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label for="filterVersion" class="form-label">App Version</label>
                        <select class="form-select" id="filterVersion">
                            <option value="">All Versions</option>
                            @foreach (var version in Model.Versions)
                            {
                                <option value="@version">@version</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label for="filterSource" class="form-label">Source</label>
                        <select class="form-select" id="filterSource">
                            <option value="">All Sources</option>
                            @foreach (var source in Model.Sources)
                            {
                                <option value="@source">@source</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label for="filterStatus" class="form-label">Status</label>
                        <select class="form-select" id="filterStatus">
                            <option value="">All Status</option>
                            <option value="false" selected>Unresolved</option>
                            <option value="true">Resolved</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label for="filterStartDate" class="form-label">Start Date</label>
                        <input type="text" class="form-control" id="filterStartDate" placeholder="Select date" />
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label for="filterEndDate" class="form-label">End Date</label>
                        <input type="text" class="form-control" id="filterEndDate" placeholder="Select date" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Resolution Status Tabs -->
<div class="row mb-3">
    <div class="col-12">
        <ul class="nav nav-tabs" id="statusTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="all-tab" data-status="" type="button">
                    <i class="bi bi-list-ul me-1"></i>All Errors
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="unresolved-tab" data-status="false" type="button">
                    <i class="bi bi-exclamation-circle me-1"></i>Unresolved
                    <span class="badge bg-danger ms-1" id="unresolvedBadge">@Model.Summary.UnresolvedErrors</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="resolved-tab" data-status="true" type="button">
                    <i class="bi bi-check-circle me-1"></i>Resolved
                    <span class="badge bg-success ms-1" id="resolvedBadge">@Model.Summary.ResolvedErrors</span>
                </button>
            </li>
        </ul>
    </div>
</div>

<!-- Data Table Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="bi bi-table me-2"></i>Error Logs</span>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-success btn-sm" id="bulkResolve" disabled>
                        <i class="bi bi-check-circle me-1"></i>Resolve Selected
                    </button>
                    <button class="btn btn-danger btn-sm" id="bulkUnresolve" disabled>
                        <i class="bi bi-x-circle me-1"></i>Unresolve Selected
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table id="errorLogTable" class="table table-striped table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width: 30px;">
                                <input type="checkbox" class="form-check-input" id="selectAll" />
                            </th>
                            <th>Status</th>
                            <th>Timestamp</th>
                            <th>Message</th>
                            <th>Source</th>
                            <th>Platform</th>
                            <th>Version</th>
                            <th>Device</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data loaded via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

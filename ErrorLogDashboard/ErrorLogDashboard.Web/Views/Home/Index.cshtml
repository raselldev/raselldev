@{
    ViewBag.Title = "Dashboard";
}

<!-- Summary Cards -->
<div class="row mb-4" id="summaryCards">
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Total Errors</h6>
                        <h2 class="mb-0" id="totalErrors">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        </h2>
                    </div>
                    <div class="icon-circle bg-danger text-white">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Unique Sources</h6>
                        <h2 class="mb-0" id="uniqueSources">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        </h2>
                    </div>
                    <div class="icon-circle bg-warning text-white">
                        <i class="bi bi-code-slash"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Platforms Affected</h6>
                        <h2 class="mb-0" id="platformsAffected">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        </h2>
                    </div>
                    <div class="icon-circle bg-info text-white">
                        <i class="bi bi-phone-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Most Affected Version</h6>
                        <h2 class="mb-0 fs-4" id="mostAffectedVersion">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        </h2>
                    </div>
                    <div class="icon-circle bg-primary text-white">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-xl-6 col-lg-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Errors by Platform</h5>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="platformChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2 text-success"></i>Errors by App Version</h5>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="versionChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2 text-warning"></i>Top 10 Error Sources</h5>
            </div>
            <div class="card-body">
                <div class="chart-container-wide">
                    <canvas id="sourceChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters and Search -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0">
        <h5 class="mb-0"><i class="bi bi-funnel-fill me-2 text-secondary"></i>Filter & Search</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="filterPlatform" class="form-label">Platform</label>
                <select class="form-select" id="filterPlatform">
                    <option value="">All Platforms</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filterVersion" class="form-label">App Version</label>
                <select class="form-select" id="filterVersion">
                    <option value="">All Versions</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filterSource" class="form-label">Source</label>
                <select class="form-select" id="filterSource">
                    <option value="">All Sources</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="searchInput" class="form-label">Search</label>
                <div class="input-group">
                    <input type="text" class="form-control" id="searchInput" placeholder="Search errors...">
                    <button class="btn btn-outline-primary" type="button" id="searchBtn">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-12 d-flex justify-content-between">
                <div>
                    <button class="btn btn-primary me-2" id="applyFilters">
                        <i class="bi bi-funnel me-1"></i>Apply Filters
                    </button>
                    <button class="btn btn-outline-secondary" id="clearFilters">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </button>
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" id="exportCsv">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
                    </button>
                    <button class="btn btn-success" id="exportExcel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-table me-2 text-info"></i>Error Logs</h5>
        <div class="d-flex align-items-center">
            <label class="me-2 mb-0">Show:</label>
            <select class="form-select form-select-sm" id="pageSize" style="width: auto;">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="errorTable">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="sortable" data-sort="TotalError">
                            Count <i class="bi bi-arrow-down-up"></i>
                        </th>
                        <th scope="col" class="sortable" data-sort="Platform">
                            Platform <i class="bi bi-arrow-down-up"></i>
                        </th>
                        <th scope="col" class="sortable" data-sort="AppVersion">
                            Version <i class="bi bi-arrow-down-up"></i>
                        </th>
                        <th scope="col" class="sortable" data-sort="Source">
                            Source <i class="bi bi-arrow-down-up"></i>
                        </th>
                        <th scope="col">Message</th>
                        <th scope="col">Device</th>
                        <th scope="col" style="width: 50px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="errorTableBody">
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Loading error logs...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-0">
        <div class="d-flex justify-content-between align-items-center">
            <div id="paginationInfo" class="text-muted">
                Showing 0 to 0 of 0 entries
            </div>
            <nav aria-label="Error log pagination">
                <ul class="pagination pagination-sm mb-0" id="pagination">
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Error Detail Modal -->
<div class="modal fade" id="errorDetailModal" tabindex="-1" aria-labelledby="errorDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorDetailModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Error Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <div class="detail-card">
                            <label class="text-muted small">Platform</label>
                            <div class="fw-bold" id="detailPlatform">-</div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="detail-card">
                            <label class="text-muted small">App Version</label>
                            <div class="fw-bold" id="detailVersion">-</div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="detail-card">
                            <label class="text-muted small">Total Occurrences</label>
                            <div class="fw-bold text-danger" id="detailCount">-</div>
                        </div>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="detail-card">
                            <label class="text-muted small">Source</label>
                            <div class="fw-bold" id="detailSource">-</div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="detail-card">
                            <label class="text-muted small">Device Info</label>
                            <div class="fw-bold" id="detailDevice">-</div>
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="text-muted small d-block mb-2">Error Message</label>
                    <div class="alert alert-danger" id="detailMessage">-</div>
                </div>
                <div>
                    <label class="text-muted small d-block mb-2">Stack Trace</label>
                    <pre class="stack-trace-box" id="detailStackTrace">-</pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
